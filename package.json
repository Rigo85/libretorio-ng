{
  "name": "libretorio-ng",
  "description": "Interfaz web de Libretorio: biblioteca autohospedada para libros, documentos, comics, manga y audiolibros.",
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve  --host 0.0.0.0",
    "start:readers": "ng serve --host 0.0.0.0 --port 8447 --ssl --ssl-cert ../local-b0-b1/tls/localhost.crt --ssl-key ../local-b0-b1/tls/localhost.key --proxy-config proxy.readers.cjs --hmr=false --live-reload=false",
    "build": "ng build --configuration production --base-href / --deploy-url /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "private": true,
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    },
    "epubjs": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@docsearch/css": "^3.6.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "crypto-js": "^4.2.0",
    "epubjs": "^0.3.93",
    "hammerjs": "^2.0.8",
    "jszip": "^3.10.1",
    "material-icons": "^1.13.12",
    "mupdf": "1.28.1",
    "ngx-spinner": "^22.0.1",
    "node-unrar-js": "^2.0.2",
    "rxjs": "~7.8.0",
    "string-similarity": "^4.0.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/hammerjs": "^2.0.45",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
